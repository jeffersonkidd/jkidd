{
  "name": "jkidd-ds",
  "private": true,
  "version": "0.1.0",
  "description": "Jefferson Kidd design system in code, in four packages that mirror the Figma libraries: @jkidd/tokens, @jkidd/core, @jkidd/ui, @jkidd/blocks, and two apps that consume them: the demo site and the link-in-bio page.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "pnpm --filter @jkidd/tokens build",
    "contrast": "pnpm --filter @jkidd/tokens contrast",
    "notebook": "pnpm --filter @jkidd/core notebook",
    "emblem": "pnpm --filter @jkidd/core emblem && node scripts/icons.mjs",
    "front": "pnpm --filter @jkidd/blocks front",
    "predev": "pnpm tokens",
    "dev": "pnpm --filter @jkidd/site --filter @jkidd/links --parallel dev",
    "prebuild": "pnpm tokens",
    "build": "pnpm --filter @jkidd/site build",
    "preview": "pnpm --filter @jkidd/site preview",
    "links": "pnpm tokens && pnpm --filter @jkidd/links dev",
    "links:build": "pnpm --filter @jkidd/links build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\" \"packages/*/scripts/*.test.mjs\"",
    "check": "pnpm tokens && pnpm contrast && pnpm test && tsc --noEmit && pnpm --filter @jkidd/site build && pnpm --filter @jkidd/links build",
    "front-inks": "pnpm --filter @jkidd/blocks front-inks",
    "stock": "pnpm --filter @jkidd/blocks stock"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
