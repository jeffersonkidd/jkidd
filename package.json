{
  "name": "jkidd-ds",
  "private": true,
  "version": "0.1.0",
  "description": "Jefferson Kidd design system in code: tokens, marks, the constant card frame and six postcard archetypes, built from the JKidd - DS Figma library.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "predev": "pnpm tokens",
    "dev": "vite",
    "prebuild": "pnpm tokens",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\"",
    "check": "pnpm tokens && pnpm contrast && pnpm test && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
