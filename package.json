{
  "name": "jkidd-ds",
  "private": true,
  "version": "0.1.0",
  "description": "Jefferson Kidd design system in code, in five packages that mirror the Figma libraries: @jkidd/tokens, @jkidd/core, @jkidd/ui, @jkidd/react, @jkidd/blocks.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "pnpm --filter @jkidd/tokens build",
    "contrast": "pnpm --filter @jkidd/tokens contrast",
    "notebook": "pnpm --filter @jkidd/core notebook",
    "predev": "pnpm tokens",
    "dev": "pnpm --filter @jkidd/site dev",
    "prebuild": "pnpm tokens",
    "build": "pnpm --filter @jkidd/site build",
    "preview": "pnpm --filter @jkidd/site preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\" \"packages/*/scripts/*.test.mjs\"",
    "check": "pnpm tokens && pnpm contrast && pnpm test && tsc --noEmit && pnpm --filter @jkidd/site build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
